{
  "name": "@meteor/platform",
  "version": "0.0.3",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:platform": "bun --filter @meteor/platform dev",
    "build:platform": "bun --filter @meteor/platform build",
    "preview:platform": "bun --filter @meteor/platform preview",
    "db:seed": "bun --filter @meteor/db db:seed"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
