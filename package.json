{
  "name": "@meteor/platform",
  "version": "0.0.6",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:platform": "bun --filter @meteor/platform dev",
    "build:platform": "bun --filter @meteor/platform build",
    "preview:platform": "bun --filter @meteor/platform preview",
    "dev:storybook": "bun --filter @meteor/storybook dev",
    "build:storybook": "bun --filter @meteor/storybook build",
    "preview:storybook": "bun --filter @meteor/storybook preview",
    "db:migrate": "bunx --bun --no-install migrate-mongo up --file migrations/migrate-mongo-config.js --migrations-dir migrations/files",
    "db:migrate:down": "bunx --bun --no-install migrate-mongo down --file migrations/migrate-mongo-config.js --migrations-dir migrations/files",
    "db:migrate:status": "bunx --bun --no-install migrate-mongo status --file migrations/migrate-mongo-config.js --migrations-dir migrations/files",
    "db:seed": "bun --filter @meteor/db db:seed"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "migrate-mongo": "14.0.7",
    "mongodb": "7.9.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
