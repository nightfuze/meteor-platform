---
import { Container, Stack } from "@meteor/ui";
import { NavigationMenu, NavigationMenuContent, NavigationMenuItem, NavigationMenuLink, NavigationMenuList, NavigationMenuTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · NavigationMenu</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">NavigationMenu</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <NavigationMenu>
        <NavigationMenuList>
          <NavigationMenuItem>
            <NavigationMenuTrigger>Игры</NavigationMenuTrigger>
            <NavigationMenuContent>
              <div class="grid gap-2 p-4 md:w-80">
                <NavigationMenuLink href="/games">Открыть каталог</NavigationMenuLink>
                <NavigationMenuLink href="/favorites">Открыть избранное</NavigationMenuLink>
              </div>
            </NavigationMenuContent>
          </NavigationMenuItem>
          <NavigationMenuItem><NavigationMenuLink href="/games/new">Опубликовать игру</NavigationMenuLink></NavigationMenuItem>
        </NavigationMenuList>
      </NavigationMenu>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">NavigationMenu, NavigationMenuContent, NavigationMenuIndicator, NavigationMenuItem, NavigationMenuLink, NavigationMenuList, NavigationMenuPositioner, NavigationMenuTrigger</p>
    </details>
  </Stack>
</Container>
