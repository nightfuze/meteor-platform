---
import { Container, Stack } from "@meteor/ui";
import Kbd from "@meteor/ui/components/ui/kbd/Kbd.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Kbd</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Kbd</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <div class="flex items-center gap-2 text-sm">Открыть поиск <Kbd>⌘</Kbd><Kbd>K</Kbd></div>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Kbd, KbdGroup</p>
    </details>
  </Stack>
</Container>
