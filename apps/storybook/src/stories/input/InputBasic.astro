---
import { Container, Stack } from "@meteor/ui";
import Input from "@meteor/ui/components/ui/input/Input.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Input</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Input</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Input aria-label="Поиск игр" placeholder="Поиск в каталоге" value="Nebula Run" />
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Input</p>
    </details>
  </Stack>
</Container>
