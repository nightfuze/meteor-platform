---
import { Container, Stack } from "@meteor/ui";
import { Select, SelectContent, SelectItem, SelectTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Select</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Select</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Select defaultValue="eu">
        <SelectTrigger placeholder="Выберите регион" />
        <SelectContent>
          <SelectItem value="eu">Europe</SelectItem>
          <SelectItem value="na">Северная Америка</SelectItem>
          <SelectItem value="asia">Азиатско-Тихоокеанский регион</SelectItem>
        </SelectContent>
      </Select>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Select, SelectContent, SelectGroup, SelectItem, SelectItemIndicator, SelectItemText, SelectLabel, SelectScrollDownButton, SelectScrollUpButton, SelectSeparator, SelectTrigger, SelectValue</p>
    </details>
  </Stack>
</Container>
