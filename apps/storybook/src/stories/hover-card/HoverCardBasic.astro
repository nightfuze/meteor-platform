---
import { Container, Stack } from "@meteor/ui";
import { HoverCard, HoverCardContent, HoverCardTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · HoverCard</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">HoverCard</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <HoverCard>
        <HoverCardTrigger class="font-medium underline decoration-dotted underline-offset-4">NovaFox</HoverCardTrigger>
        <HoverCardContent><p class="font-semibold">NovaFox</p><p class="text-sm text-muted-foreground">Уровень 24 · В сети · 128 матчей</p></HoverCardContent>
      </HoverCard>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">HoverCard, HoverCardContent, HoverCardTrigger</p>
    </details>
  </Stack>
</Container>
