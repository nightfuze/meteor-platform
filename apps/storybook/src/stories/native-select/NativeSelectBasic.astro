---
import { Container, Stack } from "@meteor/ui";
import { NativeSelect, NativeSelectOption } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · NativeSelect</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">NativeSelect</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <NativeSelect aria-label="Выберите регион сервера" name="region">
        <NativeSelectOption value="eu">Europe</NativeSelectOption>
        <NativeSelectOption value="na">Северная Америка</NativeSelectOption>
        <NativeSelectOption value="asia">Азиатско-Тихоокеанский регион</NativeSelectOption>
      </NativeSelect>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">NativeSelect, NativeSelectOptGroup, NativeSelectOption</p>
    </details>
  </Stack>
</Container>
