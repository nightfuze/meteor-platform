---
import { Container, Stack } from "@meteor/ui";
import { Button, Dropdown, DropdownContent, DropdownItem, DropdownTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Dropdown</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Dropdown</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Dropdown>
        <DropdownTrigger asChild><Button variant="outline">Меню игрока</Button></DropdownTrigger>
        <DropdownContent>
          <DropdownItem>Профиль игрока</DropdownItem>
          <DropdownItem>Пригласить в группу</DropdownItem>
          <DropdownItem>Пожаловаться на игрока</DropdownItem>
        </DropdownContent>
      </Dropdown>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Dropdown, DropdownCheckboxItem, DropdownCheckboxItemIndicator, DropdownContent, DropdownGroup, DropdownItem, DropdownLabel, DropdownLinkItem, DropdownRadioGroup, DropdownRadioItem, DropdownRadioItemIndicator, DropdownSeparator, DropdownShortcut, DropdownSub, DropdownSubContent, DropdownSubTrigger, DropdownTrigger</p>
    </details>
  </Stack>
</Container>
