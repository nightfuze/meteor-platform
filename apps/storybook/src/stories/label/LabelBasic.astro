---
import { Container, Stack } from "@meteor/ui";
import Label from "@meteor/ui/components/ui/label/Label.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Label</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Label</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Label for="player-name">Имя игрока</Label>
      <input id="player-name" class="mt-2 h-10 rounded-md border bg-background px-3" value="NovaFox" />
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Label</p>
    </details>
  </Stack>
</Container>
