---
import { Container, Stack } from "@meteor/ui";
import Badge from "@meteor/ui/components/ui/badge/Badge.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Badge</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Badge</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <div class="flex flex-wrap gap-2">
        <Badge>Приключение</Badge><Badge variant="secondary">Кооператив</Badge><Badge variant="outline">Новинка</Badge>
      </div>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Badge</p>
    </details>
  </Stack>
</Container>
