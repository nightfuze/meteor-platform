---
import { Container, Stack } from "@meteor/ui";
import { Button, Tooltip, TooltipContent, TooltipTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Tooltip</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Tooltip</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Tooltip>
        <TooltipTrigger asChild><Button variant="outline">Пинг</Button></TooltipTrigger>
        <TooltipContent>Задержка сети: 32 мс</TooltipContent>
      </Tooltip>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Tooltip, TooltipContent, TooltipTrigger</p>
    </details>
  </Stack>
</Container>
