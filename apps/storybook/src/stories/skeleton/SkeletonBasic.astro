---
import { Container, Stack } from "@meteor/ui";
import Skeleton from "@meteor/ui/components/ui/skeleton/Skeleton.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Skeleton</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Skeleton</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <div class="flex max-w-sm items-center gap-4 rounded-lg border p-4">
        <Skeleton class="size-12 rounded-full" />
        <div class="flex-1 space-y-2"><Skeleton class="h-4 w-2/3" /><Skeleton class="h-3 w-full" /></div>
      </div>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Skeleton</p>
    </details>
  </Stack>
</Container>
