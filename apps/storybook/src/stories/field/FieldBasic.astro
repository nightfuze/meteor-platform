---
import { Container, Stack } from "@meteor/ui";
import { Field, Input, Label } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Field</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Field</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Field class="max-w-md">
        <Label for="studio-name">Название студии</Label>
        <Input id="studio-name" value="Northern Lights Studio" aria-describedby="studio-hint" />
        <p id="studio-hint" class="text-sm text-muted-foreground">Отображается на опубликованной странице игры.</p>
      </Field>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Field, FieldContent, FieldControl, FieldDescription, FieldError, FieldGroup, FieldItem, FieldLabel, FieldLegend, FieldSeparator, FieldSet, FieldTitle, FieldValidity</p>
    </details>
  </Stack>
</Container>
