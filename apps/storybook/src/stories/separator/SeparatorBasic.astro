---
import { Container, Stack } from "@meteor/ui";
import { Separator } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Separator</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Separator</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <div class="max-w-sm space-y-4">
        <div><h2 class="font-semibold">Доступ к лобби</h2><p class="text-sm text-muted-foreground">Присоединиться может любой, у кого есть ссылка.</p></div>
        <Separator />
        <div><h2 class="font-semibold">Голосовой чат</h2><p class="text-sm text-muted-foreground">Включено для всех участников команды.</p></div>
      </div>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Separator</p>
    </details>
  </Stack>
</Container>
