---
import { Container, Stack } from "@meteor/ui";
import { Combobox, ComboboxContent, ComboboxInput, ComboboxItem } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Combobox</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Combobox</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Combobox defaultValue="nebula">
        <ComboboxInput placeholder="Поиск игр" />
        <ComboboxContent>
          <ComboboxItem value="nebula">Nebula Run</ComboboxItem>
          <ComboboxItem value="starlight">Starlight Arena</ComboboxItem>
          <ComboboxItem value="wilds">Wilds of Orion</ComboboxItem>
        </ComboboxContent>
      </Combobox>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Combobox, ComboboxClear, ComboboxContent, ComboboxEmpty, ComboboxGroup, ComboboxGroupLabel, ComboboxInput, ComboboxInputGroup, ComboboxItem, ComboboxItemIndicator, ComboboxItemText, ComboboxLabel, ComboboxSeparator, ComboboxTrigger, ComboboxValue</p>
    </details>
  </Stack>
</Container>
