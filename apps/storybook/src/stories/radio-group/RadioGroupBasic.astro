---
import { Container, Stack } from "@meteor/ui";
import { Label, RadioGroup, RadioGroupItem } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · RadioGroup</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">RadioGroup</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <RadioGroup name="team" defaultValue="blue" class="space-y-3">
        <div class="flex items-center gap-2"><RadioGroupItem id="team-blue" value="blue" /><Label for="team-blue">Синяя команда</Label></div>
        <div class="flex items-center gap-2"><RadioGroupItem id="team-red" value="red" /><Label for="team-red">Красная команда</Label></div>
      </RadioGroup>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">RadioGroup, RadioGroupItem</p>
    </details>
  </Stack>
</Container>
