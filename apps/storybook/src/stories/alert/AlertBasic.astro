---
import { Container, Stack } from "@meteor/ui";
import { Alert, AlertDescription, AlertTitle } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Alert</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Alert</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Alert variant="info" class="max-w-lg">
        <AlertTitle>Лобби готово</AlertTitle>
        <AlertDescription>Теперь друзья могут присоединиться к игровой сессии.</AlertDescription>
      </Alert>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Alert, AlertDescription, AlertTitle</p>
    </details>
  </Stack>
</Container>
