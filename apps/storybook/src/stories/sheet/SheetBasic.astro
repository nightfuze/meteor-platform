---
import { Container, Stack } from "@meteor/ui";
import { Button, Sheet, SheetContent, SheetDescription, SheetHeader, SheetTitle, SheetTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Sheet</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Sheet</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Sheet>
        <SheetTrigger asChild><Button variant="outline">Открыть группу</Button></SheetTrigger>
        <SheetContent>
          <SheetHeader>
            <SheetTitle>Ваша группа</SheetTitle>
            <SheetDescription>Пригласите друзей перед началом матча.</SheetDescription>
          </SheetHeader>
        </SheetContent>
      </Sheet>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Sheet, SheetClose, SheetContent, SheetDescription, SheetFooter, SheetHeader, SheetTitle, SheetTrigger</p>
    </details>
  </Stack>
</Container>
