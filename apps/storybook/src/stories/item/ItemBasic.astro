---
import { Container, Stack } from "@meteor/ui";
import { Item, ItemContent, ItemDescription, ItemTitle } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Item</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Item</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Item class="max-w-md rounded-lg border p-4">
        <ItemContent>
          <ItemTitle>Приглашение в группу</ItemTitle>
          <ItemDescription>NovaFox приглашает вас в лобби Nebula Run.</ItemDescription>
        </ItemContent>
      </Item>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Item, ItemActions, ItemContent, ItemDescription, ItemFooter, ItemGroup, ItemHeader, ItemMedia, ItemSeparator, ItemTitle</p>
    </details>
  </Stack>
</Container>
