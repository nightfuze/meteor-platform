---
import { Container, Stack } from "@meteor/ui";
import Slider from "@meteor/ui/components/ui/slider/Slider.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Slider</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Slider</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <div class="max-w-md space-y-3">
        <div class="flex justify-between text-sm"><span>Громкость голосового чата</span><span>60%</span></div>
        <Slider aria-label="Громкость голосового чата" value={[60]} min={0} max={100} />
      </div>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Slider</p>
    </details>
  </Stack>
</Container>
