---
import { Container, Stack } from "@meteor/ui";
import { Checkbox, CheckboxGroup } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · CheckboxGroup</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">CheckboxGroup</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <CheckboxGroup defaultValue={["voice"]} class="space-y-3">
        <Checkbox id="group-voice" name="lobby-options" value="voice" label="Голосовой чат" />
        <Checkbox id="group-spectators" name="lobby-options" value="spectators" label="Разрешить зрителей" />
        <Checkbox id="group-private" name="lobby-options" value="private" label="Закрытое лобби" />
      </CheckboxGroup>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">CheckboxGroup</p>
    </details>
  </Stack>
</Container>
