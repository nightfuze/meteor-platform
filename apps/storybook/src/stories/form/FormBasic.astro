---
import { Container, Stack } from "@meteor/ui";
import { Field, Form, FormErrorSummary, Input, Label } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Form</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Form</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Form class="max-w-lg space-y-4">
        <FormErrorSummary><p>Проверьте выделенные поля перед публикацией.</p></FormErrorSummary>
        <Field>
          <Label for="form-game-name">Название игры</Label>
          <Input id="form-game-name" name="name" value="Nebula Run" />
        </Field>
      </Form>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Form, FormErrorSummary</p>
    </details>
  </Stack>
</Container>
