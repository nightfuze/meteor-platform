---
import { Container, Stack } from "@meteor/ui";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Card</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Card</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Card class="max-w-md">
        <CardHeader>
          <CardTitle>Nebula Run</CardTitle>
          <CardDescription>Совместное исследование · До 12 игроков</CardDescription>
        </CardHeader>
        <CardContent>
          <p class="text-sm text-muted-foreground">Исследуйте орбитальные станции и соберите команду друзей.</p>
        </CardContent>
      </Card>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle</p>
    </details>
  </Stack>
</Container>
