---
import { Container, Stack } from "@meteor/ui";
import { Button, ButtonGroup, ButtonGroupSeparator, ButtonGroupText } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · ButtonGroup</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">ButtonGroup</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <ButtonGroup aria-label="Режим отображения каталога">
        <ButtonGroupText>Вид</ButtonGroupText>
        <Button variant="outline">Сетка</Button>
        <ButtonGroupSeparator />
        <Button variant="outline">Список</Button>
      </ButtonGroup>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">ButtonGroup, ButtonGroupSeparator, ButtonGroupText</p>
    </details>
  </Stack>
</Container>
