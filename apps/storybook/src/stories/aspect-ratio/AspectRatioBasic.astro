---
import { Container, Stack } from "@meteor/ui";
import AspectRatio from "@meteor/ui/components/ui/aspect-ratio/AspectRatio.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · AspectRatio</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">AspectRatio</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <AspectRatio ratio={16 / 9} class="max-w-xl overflow-hidden rounded-lg bg-muted">
        <div class="flex h-full items-center justify-center text-sm text-muted-foreground">Превью игры · 16:9</div>
      </AspectRatio>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">AspectRatio</p>
    </details>
  </Stack>
</Container>
