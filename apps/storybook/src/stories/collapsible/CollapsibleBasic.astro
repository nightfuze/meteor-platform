---
import { Container, Stack } from "@meteor/ui";
import { Collapsible, CollapsibleContent, CollapsibleTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Collapsible</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Collapsible</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Collapsible class="max-w-lg">
        <CollapsibleTrigger>Показать сведения о лобби</CollapsibleTrigger>
        <CollapsibleContent class="pt-3 text-sm text-muted-foreground">Карта: Орбитальная станция · Режим: командный бой · Игроки: 4/8</CollapsibleContent>
      </Collapsible>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Collapsible, CollapsibleContent, CollapsibleTrigger</p>
    </details>
  </Stack>
</Container>
