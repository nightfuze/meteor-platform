---
import { Container, Stack } from "@meteor/ui";
import { Button, Popover, PopoverContent, PopoverTrigger } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Popover</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Popover</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Popover>
        <PopoverTrigger asChild><Button variant="outline">Настройки группы</Button></PopoverTrigger>
        <PopoverContent>
          <h2 class="font-semibold">Приватность группы</h2>
          <p class="mt-1 text-sm text-muted-foreground">Друзья могут присоединиться к этому лобби.</p>
        </PopoverContent>
      </Popover>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Popover, PopoverContent, PopoverDescription, PopoverHeader, PopoverTitle, PopoverTrigger</p>
    </details>
  </Stack>
</Container>
