---
import { Container, Stack } from "@meteor/ui";
import { Button, InputGroup, InputGroupAddon, InputGroupInput, InputGroupText } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · InputGroup</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">InputGroup</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <InputGroup class="max-w-md">
        <InputGroupAddon><InputGroupText>meteor.gg/</InputGroupText></InputGroupAddon>
        <InputGroupInput aria-label="Ссылка-приглашение" value="nebula-run" readonly />
        <InputGroupAddon align="inline-end"><Button size="sm" variant="outline">Скопировать</Button></InputGroupAddon>
      </InputGroup>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">InputGroup, InputGroupAddon, InputGroupButton, InputGroupInput, InputGroupText, InputGroupTextarea</p>
    </details>
  </Stack>
</Container>
