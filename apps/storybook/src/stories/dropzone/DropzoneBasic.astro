---
import { Container, Stack } from "@meteor/ui";
import Dropzone from "@meteor/ui/components/ui/dropzone/Dropzone.astro";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Dropzone</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Dropzone</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Dropzone name="cover-art" accept="image/*" aria-label="Загрузить обложку игры">
        <div class="space-y-2 text-center"><p class="font-medium">Перетащите обложку игры сюда</p><p class="text-sm text-muted-foreground">PNG или JPG, до 10 МБ</p></div>
      </Dropzone>
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">Dropzone, DropzoneFilesList, DropzoneLoadingIndicator, DropzoneUploadIndicator</p>
    </details>
  </Stack>
</Container>
