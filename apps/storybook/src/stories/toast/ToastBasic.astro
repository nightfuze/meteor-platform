---
import { Button, Container, Stack, Toaster } from "@meteor/ui";
---

<Container class="py-8">
  <Stack gap={4}>
    <header>
      <p class="text-sm font-medium text-muted-foreground">Meteor UI · Toast</p>
      <h1 class="mt-2 text-2xl font-bold tracking-tight">Toast</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted-foreground">Основной пример компонента и его составных частей.</p>
    </header>

    <section class="rounded-lg border bg-card p-5">
      <Button data-toast-example>Показать уведомление об успехе</Button>
      <Toaster />
    </section>

    <details class="rounded-lg border p-4">
      <summary class="cursor-pointer text-sm font-semibold">Компоненты семейства</summary>
      <p class="mt-3 text-sm text-muted-foreground">ToastAction, ToastClose, ToastContent, ToastDescription, ToastItem, ToastTemplate, ToastTitle, Toaster</p>
    </details>
  </Stack>
</Container>

<script>
  import { toast } from "@meteor/ui";

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest("[data-toast-example]")) {
      toast.success("Игра добавлена в избранное", { description: "Теперь она появится в вашей библиотеке." });
    }
  });
</script>
