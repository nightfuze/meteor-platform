---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/EmptyState.astro';
import GameCard from '@/components/GameCard.astro';
import GameSection from '@/components/GameSection.astro';
import { games } from '@/api/games';
import type { Game } from '@meteor/types';
import { getCurrentUserId } from '@/api/auth';
import { favoriteRepository } from '@meteor/db';

let favoriteGames: Game[] = [];

try {
  const userId = await getCurrentUserId();
  favoriteGames = await favoriteRepository.getUserFavoriteGames(userId);
} catch {
  favoriteGames = [];
}
---

<BaseLayout
  title="Избранное"
  description="Сохранённые игры Meteor"
>
  <GameSection title="Избранное" href="/games" layout="grid">
    {favoriteGames.length === 0 ? (
    <div class="favorites-empty">
        <EmptyState
          title="Здесь пока пусто"
          text="Добавьте свою любимую игру в избранное."
        >
          <Button href="/games">Перейти в каталог</Button>
        </EmptyState>
    </div>
    ) : (
      favoriteGames.map((game) => <GameCard game={game} withPlayers={true} />)
    )}
  </GameSection>
</BaseLayout>

<style>
  .favorites-empty {
    grid-column: 1 / -1;
  }

  :global(.grid .game-card) {
    width: 100%;
  }
</style>
