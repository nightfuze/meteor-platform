---
import type { SystemInfo } from '@meteor/types';
import '../styles/main.css';

const project: SystemInfo = {
  name: 'Meteor',
  description: 'Платформа для многопользовательских браузерных игр',
  version: 'Версия 0.0.1',
  status: 'Разработка продолжается',
};
---

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{project.name}</title>
</head>
<body>
    <div class="card">
        <h1>{project.name}</h1>
        <p>{project.description}</p>
        <p class="version">{project.version}</p>
        <div class="status">{project.status}</div>
    </div>
</body>
</html>

<style>
  .card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    padding: 40px 32px;
    max-width: 480px;
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .version {
    display: inline-block;
    margin: 0 0 24px 0;
    padding: 6px 14px;
    background-color: var(--tag-bg);
    color: var(--tag-text);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-tag);
  }

  .status {
    display: flex;
    justify-content: center;
    gap: 8px;
    background-color: var(--primary-blue);
    color: #ffffff;
    padding: 12px 24px;
    border-radius: var(--radius-btn);
    font-weight: 600;
  }
</style>
