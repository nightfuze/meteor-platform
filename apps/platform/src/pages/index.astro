---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameCard from '@/components/GameCard.astro';
import GameSection from '@/components/GameSection.astro';
import { CarouselItem } from '@meteor/ui';
import { games } from '@/api/games';

const [recommended, continueRow, rising] = await Promise.all([
  games.getCatalog({ sort: 'playing', limit: 10 }),
  games.getCatalog({ sort: 'visits', limit: 10 }),
  games.getCatalog({ sort: 'newest', limit: 10 }),
]);
---

<BaseLayout
  title="Главная"
  description="Meteor - платформа для многопользовательских браузерных игр: каталог игр и публикация своих проектов."
>
  <h1>Главная</h1>

  <GameSection title="Рекомендуем вам" href="/games" layout="rail">
    {recommended.map((game) => <CarouselItem class="basis-[13.125rem]"><GameCard game={game} /></CarouselItem>)}
  </GameSection>

  <GameSection title="Продолжить" href="/games" layout="rail">
    {continueRow.map((game) => <CarouselItem class="basis-[13.125rem]"><GameCard game={game} withPlayers /></CarouselItem>)}
  </GameSection>

  <GameSection title="Набирают популярность" href="/games" layout="rail">
    {rising.map((game) => <CarouselItem class="basis-[13.125rem]"><GameCard game={game} withPlayers /></CarouselItem>)}
  </GameSection>
</BaseLayout>
