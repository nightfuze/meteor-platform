---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameCard from '@/components/GameCard.astro';
import GameSection from '@/components/GameSection.astro';
import { games } from '@/api/games';

const byPlaying = games.getCatalog({ sort: 'playing' });
const byVisits = games.getCatalog({ sort: 'visits' });
const byNewest = games.getCatalog({ sort: 'newest' });

const recommended = byPlaying.slice(0, 8);
const continueRow = byVisits.slice(0, 8);
const rising = byNewest.slice(0, 8);
---

<BaseLayout
  title="Главная"
  description="Meteor - платформа для многопользовательских браузерных игр: каталог игр и публикация своих проектов."
>
  <h1>Главная</h1>

  <GameSection title="Рекомендуем вам" href="/games" layout="rail">
    {recommended.map((game) => <GameCard game={game} />)}
  </GameSection>

  <GameSection title="Продолжить" href="/games" layout="rail">
    {continueRow.map((game) => <GameCard game={game} withPlayers />)}
  </GameSection>

  <GameSection title="Набирают популярность" href="/games" layout="rail">
    {rising.map((game) => <GameCard game={game} withPlayers />)}
  </GameSection>
</BaseLayout>
