---
import TopBar from '@/components/TopBar.astro';
import Footer from '@/components/Footer.astro';
import BottomNav from '@/components/BottomNav.astro';
import '@/styles/reset.css';
import '@/styles/tokens.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const ogImage = new URL('/logo.svg', Astro.url).href;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} — Meteor`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Meteor</title>
  </head>
  <body>
    <div class="shell">
      <TopBar />
      <div class="content">
        <main class="main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <BottomNav />
  </body>
</html>

<style>
  .shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .content {
    flex: 1;
  }

  .main {
    min-width: 0;
    padding: var(--space-5-5) var(--space-6-5) var(--space-14);
  }

  @media (max-width: --bp-lg) {
    .main {
      padding-bottom: var(--nav-clearance);
    }
  }

  @media (max-width: var(--bp-md)) {
    .main {
      padding: var(--space-4) var(--space-3-5) var(--nav-clearance);
    }
  }
</style>

<script>
  import { favorites } from '@/api/favorites';

  favorites.mount();
</script>