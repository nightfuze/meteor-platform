---
interface Props {
  gameId: string;
  tab: 'about' | 'store' | 'servers';
}

const { gameId, tab } = Astro.props;
---

<nav class="game-tabs" aria-label="Вкладки карточки игры">
  <a
    class:list={['game-tabs__link', tab === 'about' && 'game-tabs__link--active']}
    href={`/games/${gameId}?tab=about`}
    aria-current={tab === 'about' ? 'page' : undefined}
  >
    Об игре
  </a>
  <a
    class:list={['game-tabs__link', tab === 'store' && 'game-tabs__link--active']}
    href={`/games/${gameId}?tab=store`}
    aria-current={tab === 'store' ? 'page' : undefined}
  >
    Магазин
  </a>
  <a
    class:list={['game-tabs__link', tab === 'servers' && 'game-tabs__link--active']}
    href={`/games/${gameId}?tab=servers`}
    aria-current={tab === 'servers' ? 'page' : undefined}
  >
    Серверы
  </a>
</nav>

<style>
  .game-tabs {
    display: flex;
    gap: var(--spacing);
    margin-top: calc(var(--spacing) * 7);
    border-bottom: 1px solid var(--border);
  }

  .game-tabs__link {
    padding: calc(var(--spacing) * 2.5) calc(var(--spacing) * 4.5);
    border-bottom: 3px solid transparent;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 150ms cubic-bezier(0.2, 0, 0, 1);
  }

  .game-tabs__link:hover {
    color: var(--foreground);
    text-decoration: none;
  }

  .game-tabs__link--active {
    border-bottom-color: var(--foreground);
    color: var(--foreground);
  }
</style>
