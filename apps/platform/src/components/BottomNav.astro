---
import Search from '@lucide/astro/icons/search';
import Settings from '@lucide/astro/icons/settings';
import User from '@lucide/astro/icons/user';
import Plus from '@lucide/astro/icons/plus';
import LayoutGrid from '@lucide/astro/icons/layout-grid';
import Bell from '@lucide/astro/icons/bell';
import Heart from '@lucide/astro/icons/heart';
import MenuIcon from '@lucide/astro/icons/menu';
import { Button, Sheet, SheetClose, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from '@meteor/ui';
import { notifications } from '@/api/notifications';

let unreadCount = 0;
try {
  unreadCount = await notifications.getUnreadCount();
} catch {
  /* database may be unavailable */
}

const path = Astro.url.pathname;
const active = (matches: string | string[]) => {
  const list = Array.isArray(matches) ? matches : [matches];
  return list.some((match) =>
    match === '/' ? path === '/' : path === match || path.startsWith(`${match}/`),
  );
};

const menuOpenOn = ['/games/new', '/account', '/settings'];
---

<Sheet class="mobile-menu-sheet">
<nav class="bottom-nav" aria-label="Мобильная навигация">
  <a href="/games" class:list={['bottom-nav__item', { 'is-active': active('/games') && !active('/games/new') }]}>
    <LayoutGrid size={21} stroke-width={2} />
    <span>Каталог</span>
  </a>

  <a href="/favorites" class:list={['bottom-nav__item', { 'is-active': active('/favorites') }]}>
    <Heart size={21} stroke-width={2} />
    <span>Избранное</span>
  </a>

  <a href="/" class:list={['bottom-nav__center', { 'is-active': active('/') }]}>
    <img src="/logo-inverted.svg" alt="Meteor" />
  </a>

  <a
    href="/notifications"
    class:list={['bottom-nav__item', { 'is-active': active('/notifications') }]}
    aria-label={unreadCount > 0 ? `Уведомления, ${unreadCount} новых` : 'Уведомления'}
  >
    <div class="bottom-nav__icon">
      <Bell size={21} stroke-width={2} />
      {unreadCount > 0 && <span class="bottom-nav__badge">{unreadCount}</span>}
    </div>
    <span>Уведомления</span>
  </a>

  <SheetTrigger asChild>
    <Button
      variant="ghost"
      type="button"
      class:list={['bottom-nav__item', { 'is-active': active(menuOpenOn) }]}
    >
      <MenuIcon size={21} stroke-width={2} />
      <span>Меню</span>
    </Button>
  </SheetTrigger>
</nav>

  <SheetContent side="bottom" class="bottom-sheet__panel" aria-label="Мобильное меню">
    <div class="bottom-sheet__handle" aria-hidden="true"></div>
    <SheetHeader class="bottom-sheet__header">
      <SheetTitle>Меню</SheetTitle>
      <SheetClose asChild>
        <Button variant="ghost" type="button" class="bottom-sheet__close" aria-label="Закрыть меню">×</Button>
      </SheetClose>
    </SheetHeader>
    <div class="bottom-sheet__list">
      <SheetClose asChild>
        <a href="/games/new" class="bottom-sheet__item">
          <Plus size={18} stroke-width={2} />
          <span>Опубликовать игру</span>
        </a>
      </SheetClose>
      <SheetClose asChild>
        <a href="/games?search=" class="bottom-sheet__item">
          <Search size={18} stroke-width={2} />
          <span>Поиск игр</span>
        </a>
      </SheetClose>
      <SheetClose asChild>
        <a href="/settings" class="bottom-sheet__item">
          <Settings size={18} stroke-width={2} />
          <span>Настройки</span>
        </a>
      </SheetClose>
      <SheetClose asChild>
        <a href="/account" class="bottom-sheet__item">
          <User size={18} stroke-width={2} />
          <span>Профиль</span>
        </a>
      </SheetClose>
    </div>
  </SheetContent>
</Sheet>

<style>
  .bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-bottom-nav);
    display: none;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: color-mix(in oklch, var(--background) 92%, transparent);
    backdrop-filter: blur(var(--blur-md));
    border-top: var(--border-width) solid var(--border);
  }

  .bottom-nav__item,
  .bottom-nav__center {
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    flex: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0;
    border: 0;
    background: transparent;
    font-family: inherit;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1;
    cursor: pointer;
  }

  .bottom-nav__center {
    flex: 0 0 var(--size-14);
    padding: 0;
    border-radius: var(--radius-pill);
    background: transparent;
  }

  .bottom-nav__center img {
    width: var(--size-12);
    height: var(--size-12);
    padding: var(--space-0-5);
    border-radius: var(--radius-pill);
    background: var(--primary);
    border: var(--border-width-strong) solid var(--background);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--primary) 32%, transparent);
  }

  .bottom-nav__icon {
    position: relative;
    display: inline-flex;
  }

  .bottom-nav__badge {
    position: absolute;
    top: calc(-1 * var(--space-1-5));
    right: calc(-1 * var(--space-2-5));
    min-width: var(--size-4);
    height: var(--size-4);
    padding: 0 var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    line-height: var(--size-4);
    text-align: center;
  }

  .bottom-nav__item.is-active,
  .bottom-nav__center.is-active {
    color: var(--foreground);
  }

  .bottom-nav__item.is-active > svg,
  .bottom-nav__icon > svg {
    color: inherit;
  }

  .bottom-nav__item.is-active {
    color: var(--primary);
  }

  @media (max-width: --bp-lg) {
    .bottom-nav {
      display: flex;
    }
  }

  .bottom-sheet__panel {
    gap: 0;
    background: var(--background);
    border-top: var(--border-width) solid var(--border);
    border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
    padding: var(--space-2-5) var(--space-3-5) calc(var(--space-3-5) + env(safe-area-inset-bottom));
  }

  :global([data-slot='sheet-backdrop']) {
    background: var(--overlay);
  }

  :global(.bottom-sheet__panel > [data-sw-drawer-close]) {
    display: none;
  }

  .bottom-sheet__handle {
    width: var(--size-10);
    height: var(--space-1);
    margin: var(--space-0-5) auto var(--space-3-5);
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  .bottom-sheet__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0;
    padding: 0;
    margin-bottom: var(--space-2);
  }

  .bottom-sheet__close {
    width: var(--control-md);
    height: var(--control-md);
    border: none;
    border-radius: var(--radius-pill);
    color: var(--muted-foreground);
    background: var(--muted);
  }

  .bottom-sheet__list {
    display: grid;
    gap: var(--space-1);
  }

  .bottom-sheet__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-target);
    padding: var(--space-2-5) var(--space-1-5);
    color: var(--foreground);
    border-radius: var(--radius-lg);
  }

  .bottom-sheet__item:hover {
    background: var(--accent);
    text-decoration: none;
  }

</style>
