---
import Search from '@lucide/astro/icons/search';
import Settings from '@lucide/astro/icons/settings';
import User from '@lucide/astro/icons/user';
import Plus from '@lucide/astro/icons/plus';
import LayoutGrid from '@lucide/astro/icons/layout-grid';
import Bell from '@lucide/astro/icons/bell';
import Heart from '@lucide/astro/icons/heart';
import MenuIcon from '@lucide/astro/icons/menu';

const path = Astro.url.pathname;
const active = (matches: string | string[]) => {
  const list = Array.isArray(matches) ? matches : [matches];
  return list.some((match) =>
    match === '/' ? path === '/' : path === match || path.startsWith(`${match}/`),
  );
};

const menuOpenOn = ['/games/new', '/account', '/settings'];
---

<nav class="bottom-nav" aria-label="Мобильная навигация">
  <a href="/games" class:list={['bottom-nav__item', { 'is-active': active('/games') && !active('/games/new') }]}>
    <LayoutGrid size={21} stroke-width={2} />
    <span>Каталог</span>
  </a>

  <a href="/favorites" class:list={['bottom-nav__item', { 'is-active': active('/favorites') }]}>
    <Heart size={21} stroke-width={2} />
    <span>Избранное</span>
  </a>

  <a href="/" class:list={['bottom-nav__center', { 'is-active': active('/') }]}>
    <img src="/logo-inverted.svg" alt="Meteor" />
  </a>

  <a href="/" class:list={['bottom-nav__item', { 'is-active': active('/notifications') }]}>
    <div class="bottom-nav__icon">
      <Bell size={21} stroke-width={2} />
      <span class="bottom-nav__badge">3</span>
    </div>
    <span>Уведомления</span>
  </a>

  <button
    type="button"
    class="bottom-nav__item"
    aria-expanded="false"
    aria-controls="mobile-menu-sheet"
    class:list={{ 'is-active': active(menuOpenOn) }}
  >
    <MenuIcon size={21} stroke-width={2} />
    <span>Меню</span>
  </button>
</nav>

<div
  class="bottom-sheet"
  id="mobile-menu-sheet"
  role="dialog"
  aria-modal="true"
  aria-label="Мобильное меню"
  hidden
>
  <button type="button" class="bottom-sheet__backdrop" aria-label="Закрыть меню"></button>
  <div class="bottom-sheet__panel">
    <div class="bottom-sheet__handle" aria-hidden="true"></div>
    <div class="bottom-sheet__header">
      <strong>Меню</strong>
      <button type="button" class="bottom-sheet__close" aria-label="Закрыть меню">×</button>
    </div>
    <div class="bottom-sheet__list">
      <a href="/games/new" class="bottom-sheet__item">
        <Plus size={18} stroke-width={2} />
        <span>Опубликовать игру</span>
      </a>
      <a href="/games?search=" class="bottom-sheet__item">
        <Search size={18} stroke-width={2} />
        <span>Поиск игр</span>
      </a>
      <a href="/settings" class="bottom-sheet__item">
        <Settings size={18} stroke-width={2} />
        <span>Настройки</span>
      </a>
      <a href="/account" class="bottom-sheet__item">
        <User size={18} stroke-width={2} />
        <span>Профиль</span>
      </a>
    </div>
  </div>
</div>

<style>
  .bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-bottom-nav);
    display: none;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: color-mix(in oklch, var(--background) 92%, transparent);
    backdrop-filter: blur(var(--blur-md));
    border-top: var(--border-width) solid var(--border);
  }

  .bottom-nav__item,
  .bottom-nav__center {
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    flex: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0;
    border: 0;
    background: transparent;
    font-family: inherit;
    color: var(--muted-foreground);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1;
    cursor: pointer;
  }

  .bottom-nav__center {
    flex: 0 0 var(--size-14);
    padding: 0;
    border-radius: var(--radius-pill);
    background: transparent;
  }

  .bottom-nav__center img {
    width: var(--size-12);
    height: var(--size-12);
    padding: var(--space-0-5);
    border-radius: var(--radius-pill);
    background: var(--primary);
    border: var(--border-width-strong) solid var(--background);
    box-shadow: 0 4px 12px color-mix(in oklch, var(--primary) 32%, transparent);
  }

  .bottom-nav__icon {
    position: relative;
    display: inline-flex;
  }

  .bottom-nav__badge {
    position: absolute;
    top: calc(-1 * var(--space-1-5));
    right: calc(-1 * var(--space-2-5));
    min-width: var(--size-4);
    height: var(--size-4);
    padding: 0 var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: var(--text-2xs);
    font-weight: var(--weight-extrabold);
    line-height: var(--size-4);
    text-align: center;
  }

  .bottom-nav__item.is-active,
  .bottom-nav__center.is-active {
    color: var(--foreground);
  }

  .bottom-nav__item.is-active > svg,
  .bottom-nav__icon > svg {
    color: inherit;
  }

  .bottom-nav__item.is-active {
    color: var(--primary);
  }

  @media (max-width: --bp-lg) {
    .bottom-nav {
      display: flex;
    }
  }

  .bottom-sheet {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
  }

  .bottom-sheet[hidden] {
    display: none;
  }

  .bottom-sheet__backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay);
    border: none;
  }

  .bottom-sheet__panel {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--background);
    border-top: var(--border-width) solid var(--border);
    border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
    padding: var(--space-2-5) var(--space-3-5) calc(var(--space-3-5) + env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform var(--duration-slow) var(--ease-standard);
  }

  .bottom-sheet.is-open .bottom-sheet__panel {
    transform: translateY(0);
  }

  .bottom-sheet__handle {
    width: var(--size-10);
    height: var(--space-1);
    margin: var(--space-0-5) auto var(--space-3-5);
    border-radius: var(--radius-pill);
    background: var(--border);
  }

  .bottom-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .bottom-sheet__close {
    width: var(--control-md);
    height: var(--control-md);
    border: none;
    border-radius: var(--radius-pill);
    color: var(--muted-foreground);
    background: var(--muted);
  }

  .bottom-sheet__list {
    display: grid;
    gap: var(--space-1);
  }

  .bottom-sheet__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-target);
    padding: var(--space-2-5) var(--space-1-5);
    color: var(--foreground);
    border-radius: var(--radius-lg);
  }

  .bottom-sheet__item:hover {
    background: var(--accent);
    text-decoration: none;
  }

  @media (max-width: --bp-lg) {
    .bottom-sheet {
      pointer-events: none;
    }

    .bottom-sheet.is-open {
      pointer-events: auto;
    }
  }

  :global(body.bottom-sheet-open) {
    overflow: hidden;
  }
</style>

<script>
  const setupBottomSheet = () => {
    let button = document.querySelector('[aria-controls="mobile-menu-sheet"]');
    let sheet = document.getElementById('mobile-menu-sheet');
    if (!(button instanceof HTMLButtonElement) || !sheet) return;

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      sheet.hidden = !open;
      sheet.classList.toggle('is-open', open);
      document.body.classList.toggle('bottom-sheet-open', open);
    };

    const toggle = () => setOpen(button.getAttribute('aria-expanded') !== 'true');

    button.addEventListener('click', toggle, { once: false });
    sheet.querySelector('.bottom-sheet__backdrop')?.addEventListener('click', () => setOpen(false));
    sheet.querySelector('.bottom-sheet__close')?.addEventListener('click', () => setOpen(false));

    sheet.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBottomSheet);
  } else {
    setupBottomSheet();
  }
</script>
