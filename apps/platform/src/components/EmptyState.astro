---
import { Card } from '@meteor/ui';

interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<Card class="mt-6 border-dashed px-6 py-12 text-center">
  <h2 class="text-xl">{title}</h2>
  {text && <p class="mt-1.5 text-muted-foreground">{text}</p>}
  <div class="mt-4.5 flex flex-wrap justify-center gap-2.5">
    <slot />
  </div>
</Card>
