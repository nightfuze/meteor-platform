---
import SectionHead from '@/components/SectionHead.astro';
import { Carousel, CarouselContent, CarouselNext, CarouselPrevious } from '@meteor/ui';

interface Props {
  title: string;
  href?: string;
  layout?: 'rail' | 'grid';
}

const { title, href, layout = 'grid' } = Astro.props;
---

<section class="section">
  <SectionHead title={title} href={href} />
  {layout === 'rail' ? (
    <Carousel class="rail-shell">
      <CarouselContent class="rail">
        <slot />
      </CarouselContent>
      <CarouselPrevious aria-label="Предыдущая игра" class="!left-2 z-10" />
      <CarouselNext aria-label="Следующая игра" class="!right-2 z-10" />
    </Carousel>
  ) : (
    <div class="grid">
      <slot />
    </div>
  )}
</section>

<style>
  .section {
    margin-top: calc(var(--spacing) * 8);
  }

  :global([data-slot='carousel-container'].rail) {
    column-gap: var(--space-4);
    margin-left: 0;
  }

  :global([data-slot='carousel-container'].rail > [data-slot='carousel-item']) {
    padding-left: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--grid-tile-min)), 1fr));
    gap: calc(var(--spacing) * 4.5) calc(var(--spacing) * 3);
  }
</style>
