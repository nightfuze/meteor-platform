---
import ThumbsUp from '@lucide/astro/icons/thumbs-up';
import Users from '@lucide/astro/icons/users';
import { asset, formatNumber, getRating, type CatalogEntry } from '@/api/games';

interface Props {
  game: CatalogEntry;
  withPlayers?: boolean;
}

const { game, withPlayers = true } = Astro.props;

const rating = getRating(game.id);
---

<a href={`/games/${game.id}`} class="tile">
  <span class="media">
    <img src={asset(game.images.icon)} alt={game.name} loading="lazy" decoding="async" />
  </span>
  <span class="title">{game.name}</span>
  <span class="meta">
    <span class="meta__item">
      <ThumbsUp size={13} stroke-width={2} />
      {rating}%
    </span>
    {withPlayers && (
      <span class="meta__item">
        <Users size={13} stroke-width={2} />
        {formatNumber(game.metrics.playing)}
      </span>
    )}
  </span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    color: var(--card-foreground);
  }

  .tile:hover {
    text-decoration: none;
  }

  .media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--muted);
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .tile:hover .media img {
    transform: scale(1.05);
  }

  .title {
    display: -webkit-box;
    margin-top: var(--space-1-5);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .meta__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
