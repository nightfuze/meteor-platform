---
import ThumbsUp from '@lucide/astro/icons/thumbs-up';
import Users from '@lucide/astro/icons/users';
import { asset, formatNumber, getRating } from '@/api/games';
import type { Game } from '@meteor/types';

interface Props {
  game: Game;
  withPlayers?: boolean;
}

const { game, withPlayers = false } = Astro.props;

const rating = getRating(game.id);
---

<article class="game-card" data-game-card data-game-id={game.id} draggable="false">
  <a href={`/games/${game.id}`} class="game-card__link" draggable="false">
    <span class="game-card__media">
      <img src={asset(game.images.banner)} alt={game.name} loading="lazy" decoding="async" draggable="false" />
    </span>
    <span class="game-card__title">{game.name}</span>
    <span class="game-card__meta">
      <span class="game-card__meta-item">
        <ThumbsUp size={13} stroke-width={2} />
        {rating}% рейтинг
      </span>
      {withPlayers && (
        <span class="game-card__meta-item">
          <Users size={13} stroke-width={2} />
          {formatNumber(game.metrics.playing)}
        </span>
      )}
    </span>
  </a>
</article>

<style>
  .game-card {
    --game-card-width: 13.125rem;
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: var(--game-card-width);
    color: var(--card-foreground);
  }

  .game-card:hover {
    text-decoration: none;
  }

  .game-card__link {
    display: block;
    color: var(--card-foreground);
  }

  .game-card__link:hover {
    text-decoration: none;
  }

  .game-card__media {
    position: relative;
    display: block;
    aspect-ratio: 8 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--muted);
  }

  .game-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .game-card:hover .game-card__media img {
    transform: scale(1.05);
  }

  .game-card__title {
    display: -webkit-box;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .game-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }

  .game-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
