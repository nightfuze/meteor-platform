---
import { Badge, Button, Card, CardContent, CardDescription, CardHeader, CardTitle } from '@meteor/ui';
import { asset } from '@/api/games';
import type { Game } from '@meteor/types';

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<div class="game-panel">
  <section class="game-section">
    <h2 class="game-section__title">События</h2>
    <Card class="game-event p-0 gap-0">
      <div class="game-event__media">
        <img
          class="game-event__img"
          src={asset(game.images.banner)}
          alt={`Событие в ${game.name}`}
          loading="lazy"
          decoding="async"
        />
        <Badge variant="primary" class="game-event__badge">Новое событие</Badge>
      </div>
      <div class="game-event__info">
        <CardHeader class="game-event__header">
          <CardTitle class="game-event__title">Сезон {game.genre}</CardTitle>
          <CardDescription class="game-event__desc">
            Обновление открывает новый режим и временные награды. Пройдите испытания,
            чтобы получить эксклюзивные предметы.
          </CardDescription>
        </CardHeader>
        <CardContent class="game-event__footer">
          <Button variant="primary" class="w-full">Присоединиться</Button>
        </CardContent>
      </div>
    </Card>
  </section>

  <section class="game-section">
    <h2 class="game-section__title">Описание</h2>
    <p class="game-section__text">{game.description}</p>
  </section>

  {game.images.carousel.length > 0 && (
    <section class="game-section">
      <h2 class="game-section__title">Скриншоты</h2>
      <div class="game-gallery">
        {game.images.carousel.slice(0, 6).map((slide, idx) => (
          <div class="game-gallery__item">
            <img
              class="game-gallery__img"
              src={asset(slide)}
              alt={`Скриншот ${idx + 1} игры ${game.name}`}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </section>
  )}
</div>

<style>
  .game-panel {
    max-width: 48.75rem;
    margin-top: calc(var(--spacing) * 6);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 7);
  }

  .game-section__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin: 0 0 calc(var(--spacing) * 3);
  }

  .game-section__text {
    margin: 0;
    white-space: pre-line;
    line-height: var(--leading-relaxed);
    color: var(--muted-foreground);
  }

  .game-event {
    display: grid;
    max-width: var(--event-width);
    overflow: hidden;
  }

  .game-event__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--muted);
  }

  .game-event__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .game-event__badge {
    position: absolute;
    top: calc(var(--spacing) * 2);
    left: calc(var(--spacing) * 2);
  }

  .game-event__header {
    padding: calc(var(--spacing) * 3.5) calc(var(--spacing) * 4) calc(var(--spacing) * 2);
  }

  .game-event__title {
    font-size: var(--text-base);
  }

  .game-event__desc {
    margin-top: calc(var(--spacing) * 1.5);
    line-height: var(--leading-snug);
  }

  .game-event__footer {
    padding: 0 calc(var(--spacing) * 4) calc(var(--spacing) * 4);
  }

  .game-gallery {
    display: grid;
    gap: calc(var(--spacing) * 3);
    grid-template-columns: repeat(auto-fill, minmax(var(--gallery-min), 1fr));
  }

  .game-gallery__item {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--muted);
  }

  .game-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms cubic-bezier(0.2, 0, 0, 1);
  }

  .game-gallery__item:hover .game-gallery__img {
    transform: scale(1.04);
  }
</style>
