---
const { class: className, ...rest } = Astro.props;
---

<input class:list={['input', className]} autocomplete="off" {...rest} />

<style>
  .input {
    width: 100%;
    min-height: var(--control-lg);
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--foreground);
    background: var(--background);
    border: var(--border-width) solid var(--input);
    border-radius: var(--radius-sm);
  }

  .input:focus { border-color: var(--ring); box-shadow: var(--focus-ring); outline: none; }
  .input[aria-invalid='true'] { border-color: var(--destructive); background: var(--destructive-soft); }
</style>
