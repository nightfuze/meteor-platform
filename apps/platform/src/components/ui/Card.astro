---
const { class: className, ...rest } = Astro.props;
---

<div class:list={['card', className]} {...rest}><slot /></div>

<style>
  .card {
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    color: var(--card-foreground);
  }
</style>
