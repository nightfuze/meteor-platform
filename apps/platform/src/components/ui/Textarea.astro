---
const { class: className, ...rest } = Astro.props;
---

<textarea class:list={['textarea', className]} autocomplete="off" {...rest}><slot /></textarea>

<style>
  .textarea {
    width: 100%;
    min-height: var(--size-24);
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--foreground);
    background: var(--background);
    border: var(--border-width) solid var(--input);
    border-radius: var(--radius-sm);
    resize: vertical;
  }

  .textarea:focus { border-color: var(--ring); box-shadow: var(--focus-ring); outline: none; }
  .textarea[aria-invalid='true'] { border-color: var(--destructive); background: var(--destructive-soft); }
</style>
