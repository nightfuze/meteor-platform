---
import { Alert, AlertDescription, AlertTitle, Badge } from '@meteor/ui';

interface Props {
  status: number;
  title: string;
  message: string;
}

const { status, title, message } = Astro.props;
---

<section class="status">
  <Alert variant="info" class="status__alert">
    <Fragment slot="icon"><slot name="icon" /></Fragment>
    <div class="status__body">
      <div class="status__badge">
        <Badge variant="warning">HTTP {status}</Badge>
      </div>
      <AlertTitle class="status__title">{title}</AlertTitle>
      <AlertDescription class="status__description">{message}</AlertDescription>
    </div>
  </Alert>

  <div class="status__actions">
    <slot />
  </div>
</section>

<style>
  .status {
    max-width: var(--status-max);
    margin: 0 auto;
    min-height: calc(100vh - 3.5rem - 6.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 4);
    text-align: center;
  }

  .status__alert {
    align-items: flex-start;
  }

  .status__body {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1.5);
  }

  .status__badge {
    margin-bottom: calc(var(--spacing) * 0.5);
  }

  .status__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
  }

  .status__description {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .status__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: calc(var(--spacing) * 2.5);
  }
</style>
