---
import Bell from '@lucide/astro/icons/bell';
import CheckCheck from '@lucide/astro/icons/check-check';
import { Popover, PopoverTrigger, PopoverContent } from '@meteor/ui';
import { notifications, type NotificationView } from '@/api/notifications';
import { actions } from 'astro:actions';

let unreadCount = 0;
let recentNotifications: NotificationView[] = [];
try {
  ({ unreadCount, notifications: recentNotifications } = await notifications.getPopoverData());
} catch { }
---

<Popover class="notifications-popover">
  <PopoverTrigger class="notification-trigger" aria-label={`Уведомления, ${unreadCount} новых`} title="Уведомления">
    <Bell size={20} stroke-width={2} />
    {unreadCount > 0 && <span class="notification-trigger__badge">{unreadCount}</span>}
  </PopoverTrigger>
  <PopoverContent class="notifications-panel" side="bottom" align="end" sideOffset={10}>
    <div class="notifications-panel__heading">
      <strong>Уведомления</strong>
      <span>{unreadCount} новых</span>
    </div>
    {recentNotifications.length ? (
      <ul class="notifications-list">
        {recentNotifications.map((notification) => (
          <li class="notifications-list__item">
            <a href={`/games/${notification.entity.id}`}>
              <strong>{notification.title}</strong>
              <span>{notification.message}</span>
              <time datetime={notification.createdAt}>{new Date(notification.createdAt).toLocaleString('ru-RU')}</time>
            </a>
          </li>
        ))}
      </ul>
    ) : <p class="notifications-empty">Уведомлений пока нет.</p>}
    {unreadCount > 0 && <form class="notifications-panel__read-all" method="POST" action={actions.markAllNotificationsRead}>
      <button type="submit"><CheckCheck size={15} stroke-width={1.8} /> Прочитать все</button>
    </form>}
    <a class="notifications-panel__all" href="/notifications">Все уведомления</a>
  </PopoverContent>
</Popover>

<style>
  .notification-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-md);
    height: var(--control-md);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
  }
  .notification-trigger:hover { background: var(--accent); }
  .notification-trigger__badge {
    position: absolute;
    top: var(--space-0-5);
    right: var(--space-0-5);
    min-width: var(--size-4);
    height: var(--size-4);
    padding: 0 var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    line-height: var(--size-4);
    text-align: center;
  }
  .notifications-panel {
    width: min(22rem, calc(100vw - 2rem));
    padding: var(--space-3);
    background: var(--popover);
    color: var(--popover-foreground);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: var(--z-popover, 50);
  }
  .notifications-panel__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 var(--space-2-5);
    border-bottom: var(--border-width) solid var(--border);
    font-size: var(--text-sm);
  }
  .notifications-panel__heading span,
  .notifications-list time { color: var(--muted-foreground); font-size: var(--text-xs); }
  .notifications-list { list-style: none; padding: 0; margin: 0; }
  .notifications-list__item { border-bottom: var(--border-width) solid var(--border); }
  .notifications-list__item a { display: grid; gap: var(--space-1); padding: var(--space-2-5) var(--space-1); color: inherit; }
  .notifications-list__item a:hover { background: var(--accent); text-decoration: none; }
  .notifications-list__item strong { font-size: var(--text-sm); }
  .notifications-list__item span { font-size: var(--text-xs); color: var(--muted-foreground); }
  .notifications-empty { padding: var(--space-3) 0; color: var(--muted-foreground); font-size: var(--text-sm); }
  .notifications-panel__read-all { padding-top: var(--space-2-5); }
  .notifications-panel__read-all button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1-5);
    width: 100%;
    min-height: var(--control-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .notifications-panel__read-all button:hover { background: var(--accent); }
  .notifications-panel__all { display: block; padding-top: var(--space-2-5); text-align: center; font-size: var(--text-sm); font-weight: var(--weight-semibold); }
</style>
