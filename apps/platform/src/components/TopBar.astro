---
import Search from '@lucide/astro/icons/search';
import Bell from '@lucide/astro/icons/bell';
import Settings from '@lucide/astro/icons/settings';
import Coins from '@lucide/astro/icons/coins';
import TopBarLink from './TopBarLink.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Главная' },
  { href: '/games', label: 'Каталог' },
  { href: '/favorites', label: 'Избранное' },
  { href: '/games/new', label: 'Опубликовать' },
];

const activeHref = nav
  .map((item) => item.href)
  .filter((href) => path === href || (href !== '/' && path.startsWith(`${href}/`)))
  .sort((a, b) => b.length - a.length)[0];
---

<header class="topbar">
  <a href="/" class="brand">
    <img class="brand__logo" src="/logo.svg" alt="Meteor" />
    <span class="brand__wordmark">Meteor</span>
  </a>

  <nav class="nav">
    {nav.map((item) => <TopBarLink href={item.href} label={item.label} active={item.href === activeHref} />)}
  </nav>

  <form class="search" method="get" action="/games">
    <Search class="search__icon" size={17} stroke-width={2} />
    <input
      type="search"
      name="search"
      value={Astro.url.searchParams.get('search') ?? ''}
      placeholder="Поиск игр"
      aria-label="Поиск игр"
    />
  </form>

  <div class="actions">
    <span class="balance">
      <Coins size={16} stroke-width={2} />
      0
    </span>
    <span class="icon-btn" title="Уведомления">
      <Bell size={20} stroke-width={2} />
      <span class="icon-btn__badge">3</span>
    </span>
    <span class="icon-btn" title="Настройки">
      <Settings size={20} stroke-width={2} />
    </span>
    <span class="user">
      <span class="user__avatar">П</span>
      <span class="user__name">Пользователь</span>
    </span>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    height: var(--topbar-height);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-3-5);
    background: var(--background);
    border-bottom: var(--border-width) solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    margin-right: var(--space-2-5);
    color: var(--foreground);
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__logo {
    width: var(--size-8);
    height: var(--size-8);
  }

  .brand__wordmark {
    font-size: var(--text-lg);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tighter);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-0-5);
    flex-shrink: 0;
  }

  .search {
    --search-max: 27.5rem;
    position: relative;
    flex: 1;
    max-width: var(--search-max);
    margin: 0 var(--space-2-5);
  }

  .search__icon {
    position: absolute;
    top: 50%;
    left: var(--space-3);
    transform: translateY(-50%);
    color: var(--muted-foreground);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    height: var(--control-md);
    padding: 0 var(--space-3-5) 0 var(--space-9);
    font: inherit;
    font-size: var(--text-sm);
    color: var(--foreground);
    background: var(--muted);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-pill);
  }

  .search input::placeholder {
    color: var(--muted-foreground);
  }

  .search input:focus {
    background: var(--card);
    border-color: var(--ring);
    box-shadow: var(--focus-ring);
    outline: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    flex-shrink: 0;
  }

  .balance {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    height: var(--control-sm);
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--neutral);
    color: var(--neutral-foreground);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }

  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-md);
    height: var(--control-md);
    border-radius: var(--radius-sm);
    color: var(--foreground);
  }

  .icon-btn:hover {
    background: var(--accent);
  }

  .icon-btn__badge {
    position: absolute;
    top: var(--space-0-5);
    right: var(--space-0-5);
    min-width: var(--size-4);
    height: var(--size-4);
    padding: 0 var(--space-1);
    border-radius: var(--radius-pill);
    background: var(--destructive);
    color: var(--destructive-foreground);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    line-height: var(--size-4);
    text-align: center;
  }

  .user {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-md);
    padding: 0 var(--space-2-5) 0 var(--space-1);
  }

  .user__avatar {
    width: var(--size-7);
    height: var(--size-7);
    border-radius: var(--radius-circle);
    background: var(--muted);
    border: var(--border-width) solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    color: var(--muted-foreground);
  }

  .user__name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  @media (max-width: --bp-lg) {
    .nav {
      display: none;
    }
  }

  @media (max-width: --bp-md) {
    .user__name,
    .balance {
      display: none;
    }
  }
</style>