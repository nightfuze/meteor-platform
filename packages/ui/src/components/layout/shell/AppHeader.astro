---
import type { BaseLayoutProps, HeaderHeight } from "../types";
import { headerHeightClass, pickClass } from "../types";

interface Props extends BaseLayoutProps {
  height?: HeaderHeight;
  sticky?: boolean;
}

const {
  as = "div",
  class: className,
  height = "md",
  sticky = true,
  ...attrs
} = Astro.props as Props;

const Tag = as;
---

<Tag
  {...attrs}
  class:list={[
    "z-40",
    "flex",
    "w-full",
    "items-center",
    "border-b",
    "border-border",
    "bg-background",
    pickClass(headerHeightClass, height),
    { "sticky top-0": sticky },
    className
  ]}
  data-slot="app-header"
>
  <slot />
</Tag>
