---
import type { FlexLayoutProps } from "../types";
import { gapClass, pickClass } from "../types";

interface Props extends FlexLayoutProps {
}

const {
  as = "div",
  class: className,
  direction = "row",
  gap = 4,
  align,
  justify,
  wrap,
  ...attrs
} = Astro.props as Props;

const Tag = as;
---

<Tag
  {...attrs}
  class:list={[
    "flex",
    "min-w-0",
    { "flex-row": direction === "row", "flex-col": direction === "column" },
    pickClass(gapClass, gap),
    { "[&>*]:min-w-0": true },
    className
  ]}
  data-slot="split"
>
  <slot />
</Tag>
