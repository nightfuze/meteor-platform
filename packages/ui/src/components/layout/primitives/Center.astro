---
import type { BaseLayoutProps, Spacing } from "../types";
import { minHeightClass, minWidthClass, pickClass } from "../types";

interface Props extends BaseLayoutProps {
  inline?: boolean;
  minHeight?: Spacing;
  minWidth?: Spacing;
}

const {
  as = "div",
  class: className,
  inline = false,
  minHeight,
  minWidth,
  ...attrs
} = Astro.props as Props;

const Tag = as;
---

<Tag
  {...attrs}
  class:list={[
    "flex",
    "items-center",
    "justify-center",
    { "inline-flex": inline, "flex": !inline },
    pickClass(minHeightClass, minHeight),
    pickClass(minWidthClass, minWidth),
    className
  ]}
  data-slot="center"
>
  <slot />
</Tag>
