---
import type { FlexLayoutProps } from "../types";
import { gapClass, alignClasses, justifyClasses, pickClass } from "../types";

interface Props extends FlexLayoutProps {
}

const {
  as = "div",
  class: className,
  direction,
  gap = 2,
  align = "center",
  justify = "start",
  wrap = true,
  ...attrs
} = Astro.props as Props;

const Tag = as;
---

<Tag
  {...attrs}
  class:list={[
    "flex",
    "min-w-0",
    "flex-row",
    pickClass(gapClass, gap),
    pickClass(alignClasses, align),
    pickClass(justifyClasses, justify),
    { "flex-wrap": wrap },
    className
  ]}
  data-slot="inline"
>
  <slot />
</Tag>
