---
import type { BaseLayoutProps, Spacing } from "../types";
import { bleedMarginClass, pickClass } from "../types";

interface Props extends BaseLayoutProps {
  space?: Spacing;
}

const {
  as = "div",
  class: className,
  space = 4,
  ...attrs
} = Astro.props as Props;

const Tag = as;
---

<Tag
  {...attrs}
  class:list={[
    pickClass(bleedMarginClass, space),
    className
  ]}
  data-slot="bleed"
>
  <slot />
</Tag>
